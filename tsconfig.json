{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "ignoreDeprecations": "6.0",
    "types": ["@docusaurus/module-type-aliases"],
    "baseUrl": "./",
    "paths": {
      "@theme/*": ["./src/theme/*"],
      "@generated/*": ["./.docusaurus/*"],
      "@site/*": ["./*"],
      "@docusaurus/*": ["./node_modules/@docusaurus/*"]
    },
    "lib": ["DOM", "DOM.Iterable", "ES2020"]
  },
  "include": ["src", "docusaurus.config.ts"]
}
